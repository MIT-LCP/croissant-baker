    {
      "@type": "cr:FileSet",
      "@id": "wsi-files",
      "name": "Whole-slide image files",
      "description": "5 whole-slide image file(s) (akoya (1), aperio (1), hamamatsu (1), leica (1), ventana (1))",
      "encodingFormat": "image/tiff",
      "includes": [
        "**/*.bif",
        "**/*.ndpi",
        "**/*.qptiff",
        "**/*.scn",
        "**/*.svs",
        "*.bif",
        "*.ndpi",
        "*.qptiff",
        "*.scn",
        "*.svs"
      ]
    },
    {
      "@type": "cr:FileSet",
      "@id": "dicom-files",
      "name": "DICOM files",
      "description": "2 DICOM file(s) (SM (2))",
      "encodingFormat": "application/dicom",
      "includes": [
        "**/*.dcm",
        "**/*.dicom"
      ]
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "@id": "slides",
      "name": "slides",
      "description": "5 whole-slide image(s) (64-256x64-256): akoya (1), aperio (1), hamamatsu (1), leica (1), ventana (1). Objective magnification: 20-40. Compression: deflate. Associated images: label, macro, thumbnail.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "slides/image",
          "name": "image",
          "description": "Slide content (5 whole-slide file(s))",
          "dataType": "sc:ImageObject",
          "source": {
            "fileSet": {
              "@id": "wsi-files"
            },
            "extract": {
              "fileProperty": "content"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "slides/filename",
          "name": "filename",
          "description": "The slide's file name, which identifies the section",
