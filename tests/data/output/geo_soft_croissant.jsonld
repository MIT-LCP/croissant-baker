    {
      "@type": "cr:RecordSet",
      "@id": "GSE1000_family_platform_table",
      "name": "GSE1000_family_platform_table",
      "description": "Inline data table of 1 platform in GSE1000_family.soft (16 columns, 22283 rows declared). No value is emitted.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "GSE1000_family_platform_table/ID",
          "name": "ID",
          "description": "Column 'ID'. #ID = Affymetrix Probe Set ID LINK_PRE:\"https://www.affymetrix.com/LinkServlet?array=U133&probeset=\"",
