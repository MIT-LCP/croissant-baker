            "fileObject": {
              "@id": "file_1"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "GSE1000_family_platform_table/GB_ACC",
          "name": "GB_ACC",
          "description": "Column 'GB_ACC'. #GB_ACC = GenBank Accession Number LINK_PRE:\"http://www.ncbi.nlm.nih.gov/nuccore/?term=\"",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "file_1"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "GSE1000_family_platform_table/SPOT_ID",
          "name": "SPOT_ID",
          "description": "Column 'SPOT_ID'. #SPOT_ID = identifies controls",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "file_1"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "GSE1000_family_platform_table/Species_Scientific_Name",
          "name": "Species Scientific Name",
          "description": "Column 'Species Scientific Name'. #Species Scientific Name = The genus and species of the organism represented by the probe set.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "file_1"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "GSE1000_family_platform_table/Annotation_Date",
          "name": "Annotation Date",
          "description": "Column 'Annotation Date'. #Annotation Date = The date that the annotations for this probe array were last updated. It will generally be earlier than the date when the annotations were posted on the Affymetrix web site.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "file_1"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "GSE1000_family_platform_table/Sequence_Type",
          "name": "Sequence Type",
          "description": "Column 'Sequence Type'",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "file_1"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "GSE1000_family_platform_table/Sequence_Source",
          "name": "Sequence Source",
          "description": "Column 'Sequence Source'. #Sequence Source = The database from which the sequence used to design this probe set was taken.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "file_1"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "GSE1000_family_platform_table/Target_Description",
          "name": "Target Description",
          "description": "Column 'Target Description'",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "file_1"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "GSE1000_family_platform_table/Representative_Public_ID",
          "name": "Representative Public ID",
          "description": "Column 'Representative Public ID'. #Representative Public ID = The accession number of a representative sequence. Note that for consensus-based probe sets, the representative sequence is only one of several sequences (sequence sub-clusters) used to build the consensus sequence and it is not directly used to derive the probe sequences. The representative sequence is chosen during array design as a sequence that is best associated with the transcribed region being interrogated by the probe set. Refer to the \"Sequence Source\" field to determine the database used.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "file_1"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "GSE1000_family_platform_table/Gene_Title",
          "name": "Gene Title",
          "description": "Column 'Gene Title'. #Gene Title = Title of Gene represented by the probe set.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "file_1"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "GSE1000_family_platform_table/Gene_Symbol",
          "name": "Gene Symbol",
          "description": "Column 'Gene Symbol'. #Gene Symbol = A gene symbol, when one is available (from UniGene).",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "file_1"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "GSE1000_family_platform_table/ENTREZ_GENE_ID",
          "name": "ENTREZ_GENE_ID",
          "description": "Column 'ENTREZ_GENE_ID'. #ENTREZ_GENE_ID = Entrez Gene Database UID LINK_PRE:\"http://www.ncbi.nlm.nih.gov/gene/\" DELIMIT:\" /// \"",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "file_1"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "GSE1000_family_platform_table/RefSeq_Transcript_ID",
          "name": "RefSeq Transcript ID",
          "description": "Column 'RefSeq Transcript ID'. #RefSeq Transcript ID = References to multiple sequences in RefSeq. The field contains the ID and Description for each entry, and there can be multiple entries per ProbeSet.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "file_1"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "GSE1000_family_platform_table/Gene_Ontology_Biological_Process",
          "name": "Gene Ontology Biological Process",
          "description": "Column 'Gene Ontology Biological Process'. #Gene Ontology Biological Process = Gene Ontology Consortium Biological Process derived from LocusLink.  Each annotation consists of three parts: \"Accession Number // Description // Evidence\". The description corresponds directly to the GO ID. The evidence can be \"direct\", or \"extended\".",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "file_1"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "GSE1000_family_platform_table/Gene_Ontology_Cellular_Component",
          "name": "Gene Ontology Cellular Component",
          "description": "Column 'Gene Ontology Cellular Component'. #Gene Ontology Cellular Component = Gene Ontology Consortium Cellular Component derived from LocusLink.  Each annotation consists of three parts: \"Accession Number // Description // Evidence\". The description corresponds directly to the GO ID. The evidence can be \"direct\", or \"extended\".",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "file_1"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "GSE1000_family_platform_table/Gene_Ontology_Molecular_Function",
          "name": "Gene Ontology Molecular Function",
          "description": "Column 'Gene Ontology Molecular Function'. #Gene Ontology Molecular Function = Gene Ontology Consortium Molecular Function derived from LocusLink.  Each annotation consists of three parts: \"Accession Number // Description // Evidence\". The description corresponds directly to the GO ID. The evidence can be \"direct\", or \"extended\".",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "file_1"
            }
          }
        }
      ]
