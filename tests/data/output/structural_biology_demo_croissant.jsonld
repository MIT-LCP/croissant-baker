    {
      "@type": "cr:FileSet",
      "@id": "structure-files",
      "name": "Structure files",
      "description": "4 structure file(s) in CIF, PDB, mmCIF format",
      "cr:excludes": "dictionaries/audit.cif",
      "encodingFormat": [
        "chemical/x-cif",
        "chemical/x-mmcif",
        "chemical/x-pdb",
        "application/gzip"
      ],
      "includes": [
        "**/*.pdb",
        "**/*.cif",
        "**/*.cif.gz"
      ]
    },
    {
      "@type": "cr:FileSet",
      "@id": "mrc-files",
      "name": "MRC / CCP4 maps",
      "description": "2 MRC/CCP4 map file(s) (8x8x4-6; image stack, volume)",
      "encodingFormat": "application/x-mrc",
      "includes": [
        "**/*.mrc",
        "**/*.mrcs"
      ]
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "@id": "structures",
      "name": "structures",
      "description": "One record per structure file: 4 structure file(s) in CIF, PDB, mmCIF format. Experimental method(s): ELECTRON MICROSCOPY, X-RAY DIFFRACTION. Resolution: 1.8 A.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "structures/entry_id",
          "name": "entry_id",
          "description": "_entry.id, or the identifier on the HEADER record",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "structure-files"
            },
            "extract": {
              "fileProperty": "content"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "structures/title",
          "name": "title",
          "description": "_struct.title, or the TITLE record of a PDB file",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "structure-files"
            },
            "extract": {
              "fileProperty": "content"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "structures/experimental_method",
          "name": "experimental_method",
          "description": "_exptl.method, or the EXPDTA record of a PDB file",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "structure-files"
            },
            "extract": {
              "fileProperty": "content"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "structures/resolution_angstrom",
          "name": "resolution_angstrom",
          "description": "_refine.ls_d_res_high, or the RESOLUTION value of REMARK 2",
          "dataType": "sc:Float",
          "source": {
            "fileSet": {
              "@id": "structure-files"
            },
            "extract": {
              "fileProperty": "content"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "structures/space_group",
          "name": "space_group",
          "description": "_symmetry.space_group_name_H-M, or the group named on CRYST1",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "structure-files"
            },
            "extract": {
              "fileProperty": "content"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "structures/unit_cell",
          "name": "unit_cell",
          "description": "_cell lengths a, b, c and angles alpha, beta, gamma, or the same six values from CRYST1",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "structure-files"
            },
            "extract": {
              "fileProperty": "content"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "structures/n_models",
          "name": "n_models",
          "description": "Models in the file, an NMR ensemble's members",
          "dataType": "sc:Integer",
          "source": {
            "fileSet": {
              "@id": "structure-files"
            },
            "extract": {
              "fileProperty": "content"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "structures/n_chains",
          "name": "n_chains",
          "description": "Chains in the first model",
          "dataType": "sc:Integer",
          "source": {
            "fileSet": {
              "@id": "structure-files"
            },
            "extract": {
              "fileProperty": "content"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "structures/n_residues",
          "name": "n_residues",
          "description": "Residues across the chains of the first model",
          "dataType": "sc:Integer",
          "source": {
            "fileSet": {
              "@id": "structure-files"
            },
            "extract": {
              "fileProperty": "content"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "structures/n_atoms",
          "name": "n_atoms",
          "description": "Rows of _atom_site, or ATOM and HETATM records",
          "dataType": "sc:Integer",
          "source": {
            "fileSet": {
              "@id": "structure-files"
            },
            "extract": {
              "fileProperty": "content"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "structures/formula",
          "name": "formula",
          "description": "_chemical_formula_sum, the sum formula of a small-molecule CIF",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "structure-files"
            },
            "extract": {
              "fileProperty": "content"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "structures/format",
          "name": "format",
          "description": "PDB, mmCIF or CIF, from the syntax the file is written in",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "structure-files"
            },
            "extract": {
              "fileProperty": "content"
            }
          }
        }
      ]
    },
